# ==============================================================================
# Adaptive Trader AI - Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.
# NEVER commit .env to version control or expose real secrets.
# ==============================================================================

# Application Environment & Mode
# Permitted modes: BACKTEST | SIGNAL_ONLY | DEMO_TRADING
# LIVE_TRADING is STRICTLY PROHIBITED and unsupported by architecture.
APP_NAME=Adaptive Trader AI
APP_ENV=development
EXECUTION_MODE=SIGNAL_ONLY
DEBUG=false
LOG_LEVEL=INFO

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000", "http://127.0.0.1:8000"]
# Shared secret for state-changing POST endpoints (X-API-TOKEN header).
# Set a real value here: if left empty, the server generates a random token
# per process that is NEVER printed to any log — the dashboard would have no
# discoverable token to enter. Example (generate your own):
# API_TOKEN=<run: python -c "import secrets; print(secrets.token_urlsafe(32))">

# METRIC_SIGNING_KEY: HMAC-SHA256 key for the metric/model-evidence digests
# (H1 + M8: trainer registration, walk-forward attach, ML walk-forward).
# WITHOUT it the digests degrade silently to plain SHA-256 — they still
# detect accidental corruption but a database writer can re-sign a forged
# payload. Set a real random key in any environment whose evidence must be
# tamper-evident.
# OWNER RULE (2026-11-01): the owner generates a long random key on their own
# machine (command below), puts it ONLY in their own .env, keeps their own
# backup in a safe place, and NEVER sends it to a chat, a commit, a log, or
# this repository. No agent ever creates, stores, or fills in this key.
# METRIC_SIGNING_KEY=<run: python -c "import secrets; print(secrets.token_urlsafe(32))">

# Database Configuration
# Buglist item 38: a RELATIVE SQLite URL silently follows the CURRENT WORKING
# DIRECTORY of the process (uvicorn launched from another folder = a second,
# empty database). The code default resolves the repo-root absolute path; if
# you override it, use an absolute path:
#   Windows: DATABASE_URL=sqlite:///G:/mash/adaptive_trader.db
#   Linux:   DATABASE_URL=sqlite:////srv/adaptive-trader/adaptive_trader.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/adaptive_trader
# DATABASE_URL=sqlite:///./adaptive_trader.db

# Alembic migration overrides (README sections 2-3).
# ALEMBIC_DATABASE_URL: explicit destination for `alembic upgrade head` —
# REQUIRED for migration runs; without it alembic fails closed instead of
# guessing the target database. Test/example value:
# ALEMBIC_DATABASE_URL=sqlite:///./migration-smoke.db
# ALEMBIC_ALLOW_DESTRUCTIVE_DOWNGRADE: the ONLY way to run the baseline
# `downgrade` (drop_all). Never set outside a throwaway database.

# MetaTrader 5 Configuration
# Only local demo terminals are supported.
MT5_PATH=C:\Program Files\<YourBroker> MT5\terminal64.exe
MT5_SERVER=YourBroker-MT5

# Measured broker-clock offset of the CONFIGURED MT5_SERVER, in hours.
# Your broker's MT5 server stamps broker server-time as epoch (verified live 2026-10-28:
# ticks/bars exactly +3h ahead of system UTC while updating every second).
# Applied ONLY when the connected account's server equals MT5_SERVER;
# live-consistency validation flags stale on wrong-offset or ambiguous
# stamps. Set 0 to restore raw-epoch (UTC) semantics.
MT5_SERVER_TIME_OFFSET_HOURS=3.0

# Demo Trading Safety Gates
# DEMO_TRADING_ENABLED must be explicitly true to permit order dispatch in DEMO_TRADING mode.
# By default, DEMO trading is completely disabled.
DEMO_TRADING_ENABLED=false
MAX_SLIPPAGE_POINTS=10
# OCR feature flag for the document pipeline (no external OCR engine wired;
# the flag only switches the parser's OCR-aware path). Default false.
# OCR_ENABLED=false
# Strategy Rules (pages 14-15): enforce Friday-close protection and the
# 00:00-09:30 UTC session window in every production risk assessment.
# ENFORCE_SESSION_FILTER=true

# Risk Management Baseline Limits
DEFAULT_RISK_PER_TRADE_PERCENT=1.0
MAX_OPEN_TRADES=3
MAX_DAILY_LOSS_PERCENT=5.0
MAX_DRAWDOWN_PERCENT=6.0
MAX_ALLOWED_SPREAD_POINTS=35
MIN_DATA_POINTS_REQUIRED=100
# (MAX_CONSECUTIVE_EXECUTION_ERRORS removed: it was never wired to any code
# path — see backend/app/core/config.py.)

# Storage Paths
# Buglist item 38: these were missing from this template while the code reads
# them all. Paths are resolved against the repo root by default; absolute
# paths are recommended for service deployments.
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
ARTIFACTS_MODELS_DIR=./artifacts/models
ARTIFACTS_REPORTS_DIR=./artifacts/reports
# Step 3.1: watched inbox folder (auto-ingestion at startup).
# DOCUMENT_INBOX_DIR=./data/document_inbox

# Retention windows (days) for operationally-growing tables, applied once at
# startup. OWNER DECISION (2026-11-01): the defaults are 30 days for all four
# tables; a monthly summary is archived before any pruning pass deletes rows.
# Set a key to 0 to disable pruning for that single table.
# WORKER_CYCLE_RETENTION_DAYS=30
# AUDIT_LOG_RETENTION_DAYS=30
# TRADE_SIGNAL_RETENTION_DAYS=30
# DEMO_ORDER_RETENTION_DAYS=30

# SQLite busy_timeout in milliseconds (minor item 7): how long a writer waits
# for the database lock before failing with "database is locked".
# DB_BUSY_TIMEOUT_MS=5000

# Minor 16: file-log rotation (logs/app.log + numbered backups).
# LOG_ROTATE_MAX_BYTES=5242880
# LOG_ROTATE_BACKUP_COUNT=3

# Step 3.4 (owner request 2026-11-01): nightly scheduled candidate training.
# Trains ONE candidate per UTC day (21:00 UTC = 00:30 IRST) on XAUUSD M1
# market data and never promotes - activation stays a human endpoint action.
# TRAINING_SCHEDULE_ENABLED=true
# TRAINING_SCHEDULE_HOUR_UTC=21

# Buglist item 38: the Market Monitoring Worker settings were missing from
# this template entirely while every one of them is configurable.
# WORKER_ENABLED=true
# WORKER_SYMBOL=XAUUSD
# WORKER_TIMEFRAME=M1
# WORKER_POLL_INTERVAL_SECONDS=3.0
# WORKER_RETRY_BACKOFF_BASE=2.0
# WORKER_MAX_RETRY_DELAY_SECONDS=60
# WORKER_STALE_TICK_SECONDS=120
# WORKER_CYCLE_HEARTBEAT_TIMEOUT_SECONDS=120

# Buglist item 38 (round-2 items): hardening switches added by the 2026-11-05
# buglist round, documented here so they are discoverable.
# ML_WALK_FORWARD_FOLDS=4        # 0 disables the ML walk-forward evidence producer
# HEAVY_RATE_LIMIT_PER_MINUTE=10 # per-minute cap on /backtest/run + /ml/train; 0 disables
# HEALTH_PROBE_CACHE_SECONDS=20  # /health governance probe TTL; 0 disables
# SQL_ECHO=false                 # item 43: SQL logging is NOT tied to DEBUG
